# Copy to .env for local (non-docker) backend runs. In docker-compose these
# are set directly in the compose file — change the defaults there too.

DB_HOST=localhost
DB_PORT=5432
DB_USER=aaa_user
DB_PASSWORD=aaa_password
DB_NAME=aaa_portal
DB_POOL_MAX=20

# IMPORTANT: replace with a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=aaa_minio_admin
MINIO_SECRET_KEY=aaa_minio_password
MINIO_BUCKET=aaa-evidence

PORT=4000
